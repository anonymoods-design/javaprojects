public static String getEquiv(double ave, char choice)
    {
        switch(choice)
        {
            case 'L': case 'l':
            {
                if(ave >= 90)
                {
                    return "A";
                }
                else if(ave >= 89) {
                    return "B";
                }
                else if(ave >= 82) {
                    return "C";
                }
                else if(ave >= 74) {
                    return "D";
                }
                else {
                    return "F";
                }
            }
			
            case 'N':case 'n':
            {
                if (ave >= 96)
                {
                    return "4.00";
                }
                else if (ave >= 95)
                {
                    return "3.50";
                }
                else if (ave >= 89)
                {
                    return "3.00";
                }
                else if (ave >= 83)
                {
                    return "2.50";
                }
                else if (ave >= 76)
                {
                    return "2.00";
                }
                else
                {
                    return "1.00";
                }
            }
            default:
            {
                return "No Match!!!";
            }
        }
    }


    public static double getAverage(double a, double b, double c) {
        double sum = a + b + c;
        double average2 = sum / 3;
        return average2;
    }
public static String getRemarks(double average2) {
    if (average2 >= 60) {
        return "Passed";
    } else {
        return "Failed";
    }
}
 
public static void displayResult (double average, char choice, String number,
                                  String name, String course, String yearLevel) {
    System.out.println("--------------------------------------------------------------");
    System.out.println("Student Details: " + number + " " + course + " " + yearLevel);
    System.out.println("Full Name:" + name);
    System.out.println("--------------------------------------------------------------");
    System.out.printf("Average is: %.2f \n", average);
    System.out.println("Letter Grade is: " + getEquiv(average, choice));
    System.out.println("Remarks is: " + getRemarks(average));
   System.out.println("--------------------------------------------------------------");
}
 
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
